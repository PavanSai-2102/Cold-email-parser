# ═══════════════════════════════════════════════════════
#  The Closer — Environment Configuration
# ═══════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════

# ── SMTP Configuration ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ── Sender Info ──
SENDER_NAME=Your Name

# ── Runtime Behavior ──
# DRY_RUN=true means emails are previewed and logged but NOT actually sent.
# Set to false only when you are ready to send real emails.
DRY_RUN=true
SEND_MODE=smtp
INPUT_FILE=data/contacts.json
LOG_FILE=outreach_log.csv

# ── LLM via Groq (Optional) ──
# Get your API key at https://console.groq.com/keys
LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
